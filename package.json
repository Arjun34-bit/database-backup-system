{
  "name": "postgres-drive-backup",
  "version": "1.0.0",
  "private": true,
  "description": "Validated PostgreSQL backups to private Google Drive",
  "type": "commonjs",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/index.js",
    "backup": "node scripts/test-backup.js",
    "dev": "node --watch src/index.js",
    "authorize": "node scripts/authorize.js",
    "drive:folder": "node scripts/create-drive-folder.js",
    "test": "node --test test/backup.test.js test/drive.test.js"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "googleapis": "^160.0.0",
    "node-cron": "^4.2.1",
    "winston": "^3.18.3"
  }
}
